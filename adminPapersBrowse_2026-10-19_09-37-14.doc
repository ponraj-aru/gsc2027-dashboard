<style>
@page
	{size:595.3pt 841.9pt;
	margin:1.5cm 1.5cm 1.5cm 2.0cm;
	mso-header-margin:35.45pt;
	mso-footer-margin:35.45pt;
	mso-paper-source:0;}

table
	{border-collapse: collapse !important;}
hr
	{height:1px !important; border:0 !important}
}

